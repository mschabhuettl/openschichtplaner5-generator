include README.md LICENSE Dockerfile requirements.lock
recursive-include docs *.md *.json *.png
recursive-include examples *.json
recursive-include tools *.py
recursive-include tests *.py

recursive-include sp5generator/static *.html *.css *.js
include compose.yaml requirements-web.lock

include compose.portainer-dev.yaml

include tests/browser/check.cjs tests/browser/product-flows.cjs tests/browser/package.json tests/browser/package-lock.json
prune tests/browser/node_modules

include tools/release_source.cjs tests/release_source.test.cjs
