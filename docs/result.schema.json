{
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "employee_id": {
          "title": "Employee Id",
          "type": "string"
        },
        "demand_id": {
          "title": "Demand Id",
          "type": "string"
        },
        "fixed": {
          "default": false,
          "title": "Fixed",
          "type": "boolean"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Interval"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "employee_id",
        "demand_id"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "employee_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Id"
        },
        "demand_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Demand Id"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "valid",
        "complete",
        "diagnostics"
      ],
      "title": "Validation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "solver_status": {
      "enum": [
        "OPTIMAL",
        "FEASIBLE",
        "INFEASIBLE",
        "UNKNOWN",
        "MODEL_INVALID"
      ],
      "title": "Solver Status",
      "type": "string"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "title": "Assignments",
      "type": "array"
    },
    "vacancies": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Vacancies",
      "type": "object"
    },
    "validation": {
      "$ref": "#/$defs/Validation"
    },
    "runtime_seconds": {
      "title": "Runtime Seconds",
      "type": "number"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "objective_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective Value"
    },
    "best_bound": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Best Bound"
    }
  },
  "required": [
    "snapshot_id",
    "snapshot_hash",
    "solver_status",
    "validation",
    "runtime_seconds"
