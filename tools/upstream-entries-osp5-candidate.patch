+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, expect, it, vi } from 'vitest';
+import Wochenansicht from './Wochenansicht';
+import { api } from '../api/client';
+
+vi.mock('../api/client', () => ({ api: {getGroups: vi.fn().mockResolvedValue([]), getScheduleWeek: vi.fn()} }));
+afterEach(() => { cleanup(); vi.clearAllMocks(); });
+
+const row = (extra = {}) => ({employee_id: 10, employee_name: 'Synthetic', employee_short: 'S',
+  shift_id: 5, shift_name: 'Duty', shift_short: 'D', color_bk: '#FFFFFF', color_text: '#000000',
+  workplace_id: null, workplace_name: '', kind: 'shift', leave_name: '', display_name: 'D', ...extra});
+const result = (plan: string) => ({week_start: '2026-09-07', week_end: '2026-09-13', plan,
+  entry_semantics: 'source_records_not_work_totals', days: [{date: '2026-09-07', entries: [
+    row({source_id: 1, display_name: 'D1', schedule_type: plan === 'soll' ? 1 : 0}),
+    row({source_id: 2, display_name: 'D2', replaced_in_ist: plan === 'ist'}),
+    row({source_id: 3, kind: 'absence', display_name: 'A1', interval: 3, start_time: 600, end_time: 660}),
+  ]}]});
+
+it('renders every source row and requests the explicit selected plan', async () => {
+  vi.mocked(api.getScheduleWeek).mockImplementation(async (_date, _group, plan) => result(plan!) as never);
+  render(<Wochenansicht />);
+  await screen.findByText('10:00–11:00');
+  expect(screen.getAllByText('D1').length).toBeGreaterThan(0);
+  expect(screen.getAllByText('D2').length).toBeGreaterThan(0);
+  expect(screen.getByText('Ist · im Ist ersetzt')).toBeTruthy();
+  fireEvent.change(screen.getByLabelText('Plansicht'), {target: {value: 'soll'}});
+  await waitFor(() => expect(api.getScheduleWeek).toHaveBeenLastCalledWith(expect.any(String), undefined, 'soll'));
+  await waitFor(() => expect(screen.queryByText('Ist · im Ist ersetzt')).toBeNull());
+});
+
+it('rejects a legacy response instead of silently claiming plan separation', async () => {
+  const legacy = {...result('ist'), entry_semantics: undefined};
+  vi.mocked(api.getScheduleWeek).mockResolvedValue(legacy as never);
+  await act(async () => { render(<Wochenansicht />); });
+  expect(await screen.findByText(/API muss die gewählte Plansicht/)).toBeTruthy();
+  expect(screen.queryByRole('table')).toBeNull();
+});
+
+it('ignores a late response from the previously selected plan', async () => {
+  let finishOld!: (value: never) => void;
+  vi.mocked(api.getScheduleWeek).mockImplementation((_date, _group, plan) =>
+    plan === 'ist' ? new Promise(resolve => { finishOld = resolve; }) : Promise.resolve(result(plan!) as never));
+  render(<Wochenansicht />);
+  fireEvent.change(screen.getByLabelText('Plansicht'), {target: {value: 'soll'}});
+  await screen.findByText('Soll');
+  await act(async () => { finishOld(result('ist') as never); });
+  expect(screen.queryByText('Ist · im Ist ersetzt')).toBeNull();
+  expect(screen.queryByText(/API muss die gewählte Plansicht/)).toBeNull();
+});
+
+it('uses the existing ISO-week utility for the first week after New Year', async () => {
+  vi.mocked(api.getScheduleWeek).mockResolvedValue({...result('ist'), week_start: '2027-01-04', week_end: '2027-01-10'} as never);
+  render(<Wochenansicht />);
+  expect(await screen.findByText('KW 1 — 4. Jan bis 10. Jan 2027')).toBeTruthy();
+});
