+import { describe, expect, it } from 'vitest';
+import { indexScheduleEntries, sourceEntryDescription } from './scheduleEntries';
+import type { DayEntry, WeekSchedule } from '../api/client';
+
+const row = (extra: Partial<DayEntry>): DayEntry => ({
+  employee_id: 10, employee_name: 'Synthetic', employee_short: 'S',
+  shift_id: 5, shift_name: 'Duty', shift_short: 'D', color_bk: '#FFFFFF',
+  color_text: '#000000', workplace_id: null, workplace_name: '', kind: 'shift',
+  leave_name: '', display_name: 'D', ...extra,
+});
+
+describe('source entry contract', () => {
+  it('retains every same-person row, including alternative plans and absence', () => {
+    const entries = [row({schedule_type: 0}), row({schedule_type: 0, shift_id: 6}),
+      row({schedule_type: 1}), row({kind: 'absence', interval: 3, start_time: 600, end_time: 660}),
+      row({kind: 'special_shift', source_id: 8}), row({employee_id: 20, kind: null})];
+    const data = {week_start: '2026-09-07', week_end: '2026-09-13', days: [{date: '2026-09-07', entries}]} as WeekSchedule;
+    expect(indexScheduleEntries(data).get('2026-09-07')?.get(10)).toEqual(entries.slice(0, 5));
+    expect(indexScheduleEntries(data).get('2026-09-07')?.get(20)).toHaveLength(1);
+  });
+  it('labels replacement and source times without treating paid duration as work total', () => {
+    expect(sourceEntryDescription(row({schedule_type: 0, replaced_in_ist: true, startend: '08:00-16:00', duration: 6})))
+      .toBe('Ist · im Ist ersetzt · 08:00-16:00');
+    expect(sourceEntryDescription(row({schedule_type: 1}))).toBe('Soll');
+    expect(sourceEntryDescription(row({kind: 'absence', interval: 3, start_time: 600, end_time: 660}))).toBe('10:00–11:00');
+    expect(sourceEntryDescription(row({kind: 'special_shift', spshi_type: 1}))).toBe('Sonderdienst');
+  });
+});
