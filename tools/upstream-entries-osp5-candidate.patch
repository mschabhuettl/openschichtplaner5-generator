+import type { DayEntry, WeekSchedule } from '../api/client';
+
+/** Source rows, not additive working-time or paid-hour totals. */
+export function indexScheduleEntries(data: WeekSchedule) {
+  return new Map(data.days.map(day => {
+    const people = new Map<number, DayEntry[]>();
+    for (const entry of day.entries) {
+      const entries = people.get(entry.employee_id) ?? [];
+      entries.push(entry);
+      people.set(entry.employee_id, entries);
+    }
+    return [day.date, people] as const;
+  }));
+}
+
+export function sourceEntryDescription(entry: DayEntry): string {
+  const details: string[] = [];
+  if (entry.kind === 'shift') details.push(entry.schedule_type === 1 ? 'Soll' : 'Ist');
+  if (entry.kind === 'special_shift') details.push('Sonderdienst');
+  if (entry.replaced_in_ist) details.push('im Ist ersetzt');
+  if (entry.startend) details.push(entry.startend);
+  if (entry.kind === 'absence') {
+    if (entry.interval === 3) {
+      const clock = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
+      details.push(`${clock(entry.start_time ?? 0)}–${clock(entry.end_time ?? 0)}`);
+    } else {
+      details.push(['ganztägig', 'vormittags', 'nachmittags'][entry.interval ?? 0] ?? 'Intervall ungeklärt');
+    }
+  }
+  return details.join(' · ');
+}
