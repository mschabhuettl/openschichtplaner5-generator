+def _staffing_source_error(error):
+    """Stable source-free failure; never substitute empty/zero staffing.
+
+    Requires the opt-in strict Library reader candidate. Deliberately do not
+    include str(error), file paths, field values or exception-provided codes.
+    """
+    if isinstance(error, DBFValueError):
+        category = "numeric_value"
+    elif isinstance(error, DBFStructureError):
+        category = "structure"
+    elif isinstance(error, DBFReadError):
+        category = "read"
+    else:
+        return _sanitize_500(error)
+    return HTTPException(status_code=500, detail={
+        "code": "staffing_source_unresolved", "category": category,
+    })
 
 
