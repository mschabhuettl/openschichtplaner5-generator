     # ── Day schedule ──────────────────────────────────────────
+    def get_schedule_entries(self, date_str: str, group_id: int | None = None,
+                             *, plan: str, week: bool = False) -> dict:
+        """Opt-in source view, NOT an effective-work or paid-hours total.
+
+        Reuse the monthly source contract without person/day last-row-wins.
+        Keep legacy day/week facades unchanged. Cycles have no fabricated DBF
+        row identity; missing source times stay None, not zero-length work.
+        """
+        if plan not in ("ist", "soll", "both"):
+            raise ValueError("plan must be ist, soll or both")
+        first = date.fromisoformat(date_str)
+        if week:
+            first -= timedelta(days=first.weekday())
+        dates = [first + timedelta(days=i) for i in range(7 if week else 1)]
+        employees = self.get_employees(include_hidden=False)
+        if group_id is not None:
+            members = set(self.get_group_members(group_id))
+            employees = [e for e in employees if e["ID"] in members]
+        by_day = {d.isoformat(): {} for d in dates}
+        for year, month in sorted({(d.year, d.month) for d in dates}):
+            for entry in self.get_schedule(year, month, group_id=group_id,
+                                           plan=plan, source_details=True):
+                if entry["date"] in by_day:
+                    by_day[entry["date"]].setdefault(entry["employee_id"], []).append(entry)
+        days = []
+        for day, people in by_day.items():
+            entries = []
+            for employee in employees:
+                base = {
+                    "employee_id": employee["ID"],
+                    "employee_name": f"{employee.get('NAME', '')}, {employee.get('FIRSTNAME', '')}".strip(", "),
+                    "employee_short": employee.get("SHORTNAME", ""),
+                    "date": day, "kind": None, "shift_id": None,
+                    "workplace_id": None, "leave_type_id": None,
+                    "display_name": "", "shift_name": "", "shift_short": "",
+                    "leave_name": "", "workplace_name": "",
+                    "color_bk": "#FFFFFF", "color_text": "#000000",
+                }
+                entries.extend({**base, **entry} for entry in people.get(employee["ID"], [{}]))
+            days.append({"date": day, "entries": entries})
+        return {"week_start": dates[0].isoformat(), "week_end": dates[-1].isoformat(),
+                "plan": plan, "entry_semantics": "source_records_not_work_totals", "days": days}
+
