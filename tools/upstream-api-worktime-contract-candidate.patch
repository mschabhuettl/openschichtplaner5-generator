+def _build_check_result(violations, plan, from_date, to_date, rules):
+    """Explicitly bounded diagnostic, NEVER a complete planning certificate.
+
+    Reasons describe known checker capabilities, not employee violations.
+    Keep them out of the violation counter and never invent fallback rules.
+    """
+    result = _build_result(violations)
+    reasons = ["paid_hours_not_elapsed_work", "unsplit_calendar_totals",
+               "timezone_unresolved", "boundary_context_not_loaded",
+               "effective_segments_unresolved"]
+    if plan is None:
+        reasons.append("legacy_mixed_plan_sources")
+    if not rules.get("enabled", True):
+        reasons.append("rules_disabled")
+    if any(v["type"] == "weekly_model_unresolved" for v in violations):
+        reasons.append("weekly_model_unresolved")
+    result["coverage"] = {
+        "contract": "work-time-diagnostic-v1",
+        "plan": plan or "legacy_mixed", "from": from_date.isoformat(),
+        "to": to_date.isoformat(), "complete": False, "reasons": reasons,
+    }
+    return result
+
+
